{
  "name": "sewaruma-local",
  "private": true,
  "version": "0.1.0",
  "description": "Katalog rumah sewa lokal dengan backend Python dan SQLite",
  "scripts": {
    "dev": "python app.py serve",
    "start": "python app.py serve",
    "build": "python scripts/check.py",
    "build:demo": "node scripts/build-demo.cjs",
    "build:netlify": "node scripts/build-netlify.cjs",
    "test:netlify": "node --test tests/netlify-api.test.mjs",
    "dev:netlify": "node scripts/serve-netlify.mjs",
    "lint": "python scripts/check.py",
    "test": "python -m unittest discover -s tests -v"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "pg": "8.16.3"
  }
}
